+
+  b := public.antrean_panggil(a.id);
+  assert b.status = 'DIPANGGIL', 'status setelah dipanggil salah';
+  assert b.jumlah_panggil = 1, 'hitungan panggilan salah';
+  assert b.tujuan_terakhir = 'Loket Pendaftaran',
