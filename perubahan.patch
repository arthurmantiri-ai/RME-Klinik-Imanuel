+let lulus = 0, gagal = 0;
+function cek(nama, syarat, pesan) {
+  if (syarat) { lulus++; console.log('  ok  ' + nama); }
+  else { gagal++; console.error('  GAGAL  ' + nama + (pesan ? ' — ' + pesan : '')); }
+}
