+   layar 14 inci berjarak 50 cm; layar ini dilihat dari seberang ruangan
+   oleh orang yang tidak memakai kacamata bacanya. Semua ukurannya dalam
+   satuan viewport supaya nomor tetap sebesar mungkin di TV 32 inci
+   maupun di tablet yang disandarkan di meja loket.
+
+   Warna gelap dipilih bukan karena gaya: layar ini menyala 8–10 jam
+   sehari di ruangan yang sering remang, dan latar putih seterang itu
+   melelahkan orang yang duduk menghadapnya selama satu jam.
+   ===================================================================== */
+:root{
+  --bg:#07211E; --bg2:#0C302B; --garis:#13463F;
+  --teks:#EAF7F4; --redup:#84B3AC;
+  --sorot:#3BD9C0; --sorot2:#16A394;
+  --kuning:#FBBF24;
+  --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
+}
+*{box-sizing:border-box;margin:0;padding:0}
+html,body{height:100%}
+body{
+  background:var(--bg); color:var(--teks); font-family:var(--font);
+  overflow:hidden; -webkit-font-smoothing:antialiased;
+  font-variant-numeric:tabular-nums;
+}
+.layar{height:100vh;display:flex;flex-direction:column}
+
+/* -------------------------------- Kepala -------------------------------- */
+.kepala{
+  display:flex;align-items:center;justify-content:space-between;gap:2vw;
+  padding:1.6vh 2.4vw;border-bottom:1px solid var(--garis);background:var(--bg2);
+}
+.merek{display:flex;align-items:center;gap:1.2vw;min-width:0}
+.logo{
+  width:clamp(38px,3.4vw,64px);height:clamp(38px,3.4vw,64px);border-radius:14px;
+  background:linear-gradient(135deg,var(--sorot),var(--sorot2));
+  display:grid;place-items:center;color:#04211D;
+  font-weight:800;font-size:clamp(15px,1.5vw,26px);flex:none;
+}
+.merek h1{font-size:clamp(15px,1.7vw,30px);font-weight:700;letter-spacing:.2px;
+  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.merek p{font-size:clamp(11px,1vw,17px);color:var(--redup);margin-top:2px}
+.jam{text-align:right;flex:none}
+.jam b{font-size:clamp(22px,3.2vw,58px);font-weight:800;line-height:1;letter-spacing:-.5px}
+.jam span{display:block;font-size:clamp(11px,1vw,18px);color:var(--redup);margin-top:.5vh}
+
+/* -------------------------------- Isi ----------------------------------- */
+.isi{flex:1;display:grid;grid-template-columns:38% 1fr;gap:1.4vw;
+  padding:1.6vh 2.4vw;min-height:0}
+
+/* Panggilan yang sedang berlangsung */
+.sorotan{
+  background:linear-gradient(160deg,#0E3B34,#0A2C27);
+  border:2px solid var(--garis);border-radius:20px;
+  display:flex;flex-direction:column;justify-content:center;align-items:center;
+  padding:2vh 1.6vw;text-align:center;position:relative;overflow:hidden;
+}
+.sorotan.nyala{border-color:var(--sorot);box-shadow:0 0 0 6px rgba(59,217,192,.10)}
+.sorotan .label{font-size:clamp(11px,1.15vw,20px);letter-spacing:.28em;
+  text-transform:uppercase;color:var(--sorot);font-weight:700}
+.sorotan .nomor{
+  font-size:clamp(64px,12vw,220px);font-weight:800;line-height:.95;
+  letter-spacing:-.03em;margin:1.4vh 0;word-break:break-all;
+}
+.sorotan .tujuan{font-size:clamp(16px,2.1vw,40px);font-weight:600;color:var(--teks)}
+.sorotan .waktu{font-size:clamp(11px,1vw,18px);color:var(--redup);margin-top:1vh}
+.sorotan .ulang{
+  margin-top:1.2vh;display:inline-block;padding:.5vh 1.1vw;border-radius:999px;
+  background:rgba(251,191,36,.15);color:var(--kuning);
+  font-size:clamp(11px,1vw,18px);font-weight:700;
+}
+.sorotan.nyala::after{
+  content:'';position:absolute;inset:0;border-radius:18px;
+  border:2px solid var(--sorot);animation:denyut 1.1s ease-out 3;pointer-events:none;
+}
+@keyframes denyut{from{opacity:.9;transform:scale(1)}to{opacity:0;transform:scale(1.04)}}
+
+/* Kanan: kartu per poli + panggilan sebelumnya */
+.kanan{display:flex;flex-direction:column;gap:1.4vh;min-height:0}
+.poli-grid{display:grid;gap:1.2vw;flex:1;min-height:0;
+  grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr))}
+.poli{
+  background:var(--bg2);border:1px solid var(--garis);border-radius:16px;
+  padding:1.6vh 1.4vw;display:flex;flex-direction:column;min-height:0;
+}
+.poli h2{font-size:clamp(13px,1.35vw,25px);font-weight:700;
+  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
+.poli .besar{font-size:clamp(34px,5vw,86px);font-weight:800;line-height:1.05;
+  margin:.6vh 0;color:var(--sorot)}
+.poli .besar.kosong{color:var(--redup);opacity:.45}
+.poli .kecil{font-size:clamp(10px,.95vw,16px);color:var(--redup);letter-spacing:.14em;
+  text-transform:uppercase;font-weight:700}
+.berikut{display:flex;gap:.5vw;flex-wrap:wrap;margin-top:auto;padding-top:1vh}
+.berikut span{
+  background:rgba(255,255,255,.05);border:1px solid var(--garis);border-radius:9px;
+  padding:.35vh .7vw;font-size:clamp(11px,1.05vw,19px);font-weight:600;color:var(--teks);
+}
+.poli .sisa{font-size:clamp(11px,1.05vw,18px);color:var(--redup);margin-top:.8vh}
+
+.riwayat{
+  background:var(--bg2);border:1px solid var(--garis);border-radius:16px;
+  padding:1.2vh 1.4vw;flex:none;
+}
+.riwayat .kecil{font-size:clamp(10px,.9vw,15px);color:var(--redup);
+  letter-spacing:.14em;text-transform:uppercase;font-weight:700;margin-bottom:.8vh}
+.riwayat ul{list-style:none;display:flex;gap:.8vw;flex-wrap:wrap}
+.riwayat li{font-size:clamp(11px,1.05vw,19px);color:var(--redup)}
+.riwayat li b{color:var(--teks);font-weight:700}
+
+/* -------------------------------- Kaki ---------------------------------- */
+.kaki{
+  border-top:1px solid var(--garis);background:var(--bg2);
+  padding:1.2vh 2.4vw;display:flex;align-items:center;gap:1.6vw;flex:none;
+}
+.jalan{flex:1;overflow:hidden;white-space:nowrap}
+.jalan span{display:inline-block;padding-left:100%;
+  font-size:clamp(12px,1.25vw,22px);color:var(--redup);
+  animation:geser 28s linear infinite}
+@keyframes geser{to{transform:translateX(-100%)}}
+.status{display:flex;align-items:center;gap:.6vw;font-size:clamp(10px,.9vw,15px);
+  color:var(--redup);flex:none}
+.titik{width:9px;height:9px;border-radius:50%;background:var(--sorot);flex:none}
+.titik.putus{background:#F87171}
+
+/* Tombol suara: perlu ada karena peramban menolak membunyikan apa pun
+   sebelum ada yang menyentuh layar sekali. Setelah ditekan ia hilang. */
+.tombol{
+  background:var(--sorot);color:#04211D;border:0;border-radius:999px;
+  padding:.9vh 1.6vw;font-size:clamp(12px,1.15vw,19px);font-weight:700;
+  font-family:inherit;cursor:pointer;flex:none;
+}
+.tombol:hover{background:#5AE6D0}
+
+/* Pesan penuh layar untuk keadaan tidak normal */
+.pesan{
+  position:fixed;inset:0;background:var(--bg);display:grid;place-items:center;
+  text-align:center;padding:6vw;z-index:9;
+}
+.pesan div{max-width:900px}
+.pesan h2{font-size:clamp(20px,3vw,44px);margin-bottom:2vh}
+.pesan p{font-size:clamp(13px,1.4vw,22px);color:var(--redup);line-height:1.65}
+.pesan code{background:var(--bg2);padding:.3em .5em;border-radius:7px;
+  font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.92em;color:var(--sorot)}
+[hidden]{display:none!important}
+
+@media (max-width:900px){
+  .isi{grid-template-columns:1fr;grid-template-rows:auto 1fr}
+  .sorotan .nomor{font-size:clamp(56px,18vw,120px)}
+}
+</style>
+</head>
+<body>
+
+<div class="layar">
+  <header class="kepala">
+    <div class="merek">
+      <div class="logo" id="logo">KI</div>
+      <div style="min-width:0">
+        <h1 id="namaKlinik">Klinik</h1>
+        <p id="judulLayar">Antrean Pasien</p>
+      </div>
+    </div>
+    <div class="jam">
+      <b id="jam">--:--</b>
+      <span id="tanggal"></span>
+    </div>
+  </header>
+
+  <main class="isi">
+    <section class="sorotan" id="sorotan">
+      <div class="label">Sedang dipanggil</div>
+      <div class="nomor" id="nomorBesar">—</div>
+      <div class="tujuan" id="tujuanBesar">Menunggu panggilan</div>
+      <div class="waktu" id="waktuBesar"></div>
+      <div class="ulang" id="ulangBesar" hidden></div>
+    </section>
+
+    <section class="kanan">
+      <div class="poli-grid" id="poliGrid"></div>
+      <div class="riwayat" id="riwayat" hidden>
+        <div class="kecil">Panggilan sebelumnya</div>
+        <ul id="riwayatIsi"></ul>
+      </div>
+    </section>
+  </main>
+
+  <footer class="kaki">
+    <button class="tombol" id="btnSuara">🔔 Aktifkan suara</button>
+    <div class="jalan"><span id="teksJalan"></span></div>
+    <div class="status"><span class="titik" id="titik"></span><span id="statusTeks">Terhubung</span></div>
+  </footer>
+</div>
+
+<div class="pesan" id="pesan" hidden><div>
+  <h2 id="pesanJudul">Memuat…</h2>
+  <p id="pesanIsi"></p>
+</div></div>
+
+<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>
+<script src="js/config.js"></script>
+<script src="js/antrean_core.js"></script>
+<script src="js/display.js"></script>
+</body>
+</html>
diff --git a/js/antrean_core.js b/js/antrean_core.js
new file mode 100644
index 0000000..33ab831
--- /dev/null
+++ b/js/antrean_core.js
@@ -0,0 +1,222 @@
+/* =====================================================================
+   ANTREAN — FUNGSI MURNI
+   Tidak menyentuh DOM maupun Supabase, sehingga bisa diuji dengan
+   `node test/uji_antrean_core.js`.
+
+   Beberapa fungsi di sini SENGAJA menghitung ulang hal yang juga
+   dihitung database — bentuk nomor antrean, kalimat panggilan, dan
+   pemeriksaan nomor kartu. Itu bukan duplikasi yang terlupa: layar
+   tunggu dan panel uji coba harus bisa menyusun kalimat tanpa menunggu
+   jawaban server, sementara BPJS harus melihat nilai yang persis sama.
+
+   Karena itu keduanya dijaga oleh CONTOH UJI YANG SAMA PERSIS —
+   test/uji_antrean.sql dan test/uji_antrean_core.js memakai nomor,
+   kartu, dan tanggal yang sama. Kalau salah satu diubah, ujinya yang
+   gagal, bukan hasilnya yang diam-diam berselisih di klinik.
+   ===================================================================== */
+const AntreanCore = (() => {
+
+  /* ---------------- Bentuk nomor antrean ------------------------------
+     Pasangan kolom `nomor` di tabel antrean:
+       prefix || '-' || lpad(no_urut, greatest(3, length(no_urut)), '0')
+
+     padStart di JavaScript tidak memotong, lpad di PostgreSQL memotong.
+     greatest(3, ...) di SQL ada supaya keduanya sama pada nomor 4 digit;
+     di sini padStart(3) sudah cukup. Uji nomor 1000 di kedua berkas
+     menjaga agar perbedaan itu tidak pernah menjadi selisih.            */
+  function formatNomor(prefix, urut) {
+    const n = Number(urut);
+    if (!Number.isFinite(n) || n <= 0) return '';
+    return `${String(prefix || 'A').toUpperCase()}-${String(Math.trunc(n)).padStart(3, '0')}`;
+  }
+
+  function pecahNomor(nomor) {
+    const m = /^([A-Za-z]+)-(\d+)$/.exec(String(nomor || '').trim());
+    if (!m) return null;
+    return { prefix: m[1].toUpperCase(), urut: parseInt(m[2], 10) };
+  }
+
+  /* ---------------- Kalimat panggilan (untuk suara) -------------------
+     Pembaca suara peramban membaca "A-014" sebagai "A minus nol satu
+     empat" — angka nolnya ikut terbaca dan tanda hubungnya jadi "minus".
+     Yang dikirim ke pembaca suara karena itu bukan nomornya, melainkan
+     kalimat yang sudah dieja: "A, 14".                                  */
+  function ejaNomor(nomor) {
+    const p = pecahNomor(nomor);
+    if (!p) return String(nomor || '');
+    return `${p.prefix}, ${p.urut}`;
+  }
+
+  function teksPanggilan(nomor, tujuan, ulang = 1) {
+    const eja = ejaNomor(nomor);
+    const ke = tujuan ? `, silakan menuju ${tujuan}` : '';
+    // Panggilan ulang diberi awalan supaya pasien yang tadi tidak dengar
+    // tahu bahwa ini kesempatan kedua, bukan nomor yang berbeda.
+    const awal = ulang > 1 ? 'Panggilan ulang. ' : '';
+    return `${awal}Nomor antrean ${eja}${ke}.`;
+  }
+
+  /* ---------------- Pemeriksaan identitas -----------------------------
+     Bentuknya sama persis dengan antrol_periksa_kartu() dan
+     antrol_periksa_nik() di sql/15_antrean.sql, termasuk urutan
+     pemeriksaannya: kosong dulu, lalu bukan angka, baru panjangnya.
+     Urutan itu menentukan pesan mana yang dilihat petugas.              */
+  function periksaKartu(noKartu) {
+    const s = String(noKartu ?? '').trim();
+    if (s === '')          return 'Nomor kartu tidak boleh kosong';
+    if (!/^\d+$/.test(s))  return 'Format nomor kartu tidak sesuai';
+    if (s.length !== 13)   return 'Nomor kartu harus 13 digit';
+    return null;
+  }
+
+  function periksaNik(nik) {
+    const s = String(nik ?? '').trim();
+    if (s === '')          return 'NIK tidak boleh kosong';
+    if (!/^\d+$/.test(s))  return 'Format NIK tidak sesuai';
+    if (s.length !== 16)   return 'NIK harus 16 digit';
+    return null;
+  }
+
+  function periksaTanggal(tgl) {
+    const s = String(tgl ?? '').trim();
+    if (!/^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/.test(s))
+      return 'Format tanggal tidak sesuai, format yang benar adalah yyyy-mm-dd';
+    return null;
+  }
+
+  /* ---------------- Jadwal --------------------------------------------
+     Jam dibandingkan sebagai teks 'HH:MM'. Itu sah karena format jamnya
+     tetap dan berpadding nol — dan jauh lebih aman daripada membuat
+     objek Date, yang akan menyeret zona waktu perangkat masuk ke dalam
+     keputusan buka-tutup poli.                                          */
+  const HARI = ['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];
+
+  const jamPendek = (j) => String(j ?? '').slice(0, 5);
+
+  function sedangBuka(jadwal, jamSekarang) {
+    if (!jadwal || !jadwal.jam_buka) return false;
+    const j = jamPendek(jamSekarang);
+    return j >= jamPendek(jadwal.jam_buka) && j <= jamPendek(jadwal.jam_tutup);
+  }
+
+  function bolehDaftarOnline(jadwal, tanggal, hariIni, jamSekarang) {
+    if (!jadwal || !jadwal.jam_buka) return { boleh: false, alasan: 'Poli tidak melayani hari itu' };
+    if (tanggal < hariIni) return { boleh: false, alasan: 'Tanggal periksa tidak berlaku mundur' };
+    if (tanggal === hariIni) {
+      const batas = jamPendek(jadwal.jam_tutup_online || jadwal.jam_tutup);
+      if (jamPendek(jamSekarang) > batas)
+        return { boleh: false, alasan: `Pendaftaran online hari ini sudah ditutup pukul ${batas}` };
+    }
+    if ((jadwal.sisa_kuota_online ?? 1) <= 0)
+      return { boleh: false, alasan: 'Kuota antrean online sudah penuh' };
+    return { boleh: true, alasan: null };
+  }
+
+  /* ---------------- Estimasi waktu dilayani ---------------------------
+     Kasar dengan sengaja: rata-rata menit per pasien dikali jumlah orang
+     di depan. Angka yang lebih pintar (rata-rata bergerak dari waktu
+     layan hari ini) terdengar meyakinkan tetapi meleset jauh pada pagi
+     hari ketika sampelnya baru dua orang — dan pasien mengingat estimasi
+     yang meleset lebih lama daripada estimasi yang kasar.               */
+  function estimasiMenit(jumlahDiDepan, menitPerPasien = 10) {
+    const n = Math.max(0, Number(jumlahDiDepan) || 0);
+    return n * (Number(menitPerPasien) || 10);
+  }
+
+  function estimasiTeks(jumlahDiDepan, menitPerPasien = 10) {
+    const m = estimasiMenit(jumlahDiDepan, menitPerPasien);
+    if (m <= 0)  return 'Segera dipanggil';
+    if (m < 60)  return `± ${m} menit lagi`;
+    const jam = Math.floor(m / 60), sisa = m % 60;
+    return sisa ? `± ${jam} jam ${sisa} menit lagi` : `± ${jam} jam lagi`;
+  }
+
+  /* ---------------- Lencana keadaan ----------------------------------- */
+  const LABEL = {
+    BELUM_HADIR: ['Belum hadir',  'b-menunggu'],
+    MENUNGGU:    ['Menunggu',     'b-dokter'],
+    DIPANGGIL:   ['Dipanggil',    'b-kajian'],
+    DILAYANI:    ['Dilayani',     'b-periksa'],
+    SELESAI:     ['Selesai',      'b-selesai'],
+    TIDAK_HADIR: ['Tidak hadir',  'b-batal'],
+    BATAL:       ['Batal',        'b-batal']
+  };
+  const labelStatus = (s) => LABEL[s] || [s, 'b-batal'];
+
+  const LABEL_SUMBER = {
+    LOKET:    'Loket',
+    ONLINE:   'Mobile JKN',
+    ANJUNGAN: 'Anjungan mandiri'
+  };
+  const labelSumber = (s) => LABEL_SUMBER[s] || s;
+
+  /* Antrean mana yang masih hidup — dipakai penyaringan di banyak tempat,
+     jadi definisinya ditulis sekali saja di sini. */
+  const AKTIF = ['BELUM_HADIR', 'MENUNGGU', 'DIPANGGIL', 'DILAYANI'];
+  const masihAktif = (a) => AKTIF.includes(a && a.status);
+
+  /* ---------------- Token & tautan layar ------------------------------
+     Sumber acak disuntikkan supaya bisa diuji. Di peramban yang dipakai
+     crypto.getRandomValues, bukan Math.random: token inilah satu-satunya
+     yang menjaga alamat layar tunggu.                                    */
+  const HURUF = 'abcdefghijkmnopqrstuvwxyz23456789';   // tanpa l, 0, 1
+
+  function acakToken(panjang = 40, acak = null) {
+    const n = Math.max(24, panjang);
+    let byte;
+    if (acak) {
+      byte = acak(n);
+    } else if (typeof crypto !== 'undefined' && crypto.getRandomValues) {
+      byte = crypto.getRandomValues(new Uint8Array(n));
+    } else {
+      byte = Array.from({ length: n }, () => Math.floor(Math.random() * 256));
+    }
+    let s = '';
+    for (let i = 0; i < n; i++) s += HURUF[byte[i] % HURUF.length];
+    return s;
+  }
+
+  function urlLayar(asal, token) {
+    if (!token) return '';
+    const dasar = String(asal || '').replace(/\/+$/, '').replace(/\/(app|index|demo)\.html.*$/, '');
+    return `${dasar}/display.html?t=${encodeURIComponent(token)}`;
+  }
+
+  /* ---------------- Membaca jawaban Antrol ----------------------------
+     Dipakai panel "Uji coba" di Pengaturan supaya petugas melihat hasil
+     dalam bahasa manusia, bukan JSON.                                    */
+  function bacaJawaban(json) {
+    const meta = (json && json.metadata) || {};
+    const kode = Number(meta.code ?? 0);
+    const r = (json && json.response) || null;
+    const ok = kode === 200 || kode === 202;
+    let ringkas = meta.message || (ok ? 'Ok' : 'Gagal');
+    if (ok && r) {
+      const bagian = [];
+      if (r.nomorantrean)   bagian.push(`Nomor ${r.nomorantrean}`);
+      if (r.namapoli)       bagian.push(r.namapoli);
+      if (r.totalantrean !== undefined) bagian.push(`${r.totalantrean} total`);
+      if (r.sisaantrean !== undefined)  bagian.push(`${r.sisaantrean} menunggu`);
+      if (r.antreanpanggil)  bagian.push(`sedang dipanggil ${r.antreanpanggil}`);
+      if (bagian.length) ringkas = bagian.join(' · ');
+    }
+    return {
+      ok, kode, ringkas,
+      // 202 bukan kegagalan: nomornya terbit, hanya pesertanya belum
+      // terdaftar sebagai pasien di klinik ini.
+      pasienBaru: kode === 202,
+      pesan: meta.message || ''
+    };
+  }
+
+  return {
+    formatNomor, pecahNomor, ejaNomor, teksPanggilan,
+    periksaKartu, periksaNik, periksaTanggal,
+    sedangBuka, bolehDaftarOnline, jamPendek, HARI,
+    estimasiMenit, estimasiTeks,
+    labelStatus, labelSumber, masihAktif, AKTIF,
+    acakToken, urlLayar, bacaJawaban
+  };
+})();
+
+if (typeof module !== 'undefined' && module.exports) module.exports = AntreanCore;
diff --git a/js/app.js b/js/app.js
index d9769df..6ed64f7 100644
--- a/js/app.js
