+        <td style="width:1%" class="nowrap">
+          <span class="badge ${l.ok ? 'b-selesai' : 'b-batal'}">${l.ok ? 'OK' : 'GAGAL'}</span></td>
+        <td class="mono text-xs">${UI.esc(l.nama)}</td>
+        <td class="text-sm">${UI.esc(l.pesan)}</td>
